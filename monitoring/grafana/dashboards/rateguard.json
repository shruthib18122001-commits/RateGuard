{
  "uid": "rateguard-overview",
  "title": "RateGuard Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["rateguard"],
  "panels": [
    {
      "id": 1,
      "title": "Allow vs Deny Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "sum(rate(rateguard_rate_limit_decisions_total{decision=\"allowed\"}[1m]))",
          "legendFormat": "allowed"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "sum(rate(rateguard_rate_limit_decisions_total{decision=\"denied\"}[1m]))",
          "legendFormat": "denied"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "sum(rate(rateguard_request_duration_seconds_count[1m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(rateguard_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(rateguard_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(rateguard_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis Circuit Breaker State",
      "type": "state-timeline",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "options": { "showValue": "auto", "mergeValues": true, "rowHeight": 0.9 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "closed", "color": "green", "index": 0 },
                "1": { "text": "open", "color": "red", "index": 1 },
                "2": { "text": "half_open", "color": "yellow", "index": 2 }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "max(rateguard_breaker_state)",
          "legendFormat": "breaker"
        }
      ]
    },
    {
      "id": 5,
      "title": "Breaker Transitions & Fallbacks (per minute)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "sum by (from_state, to_state) (increase(rateguard_breaker_transitions_total[1m]))",
          "legendFormat": "{{from_state}} → {{to_state}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
          "expr": "sum by (policy) (increase(rateguard_breaker_fallbacks_total[1m]))",
          "legendFormat": "fallback ({{policy}})"
        }
      ]
    }
  ]
}
